# /etc/ci-gated-update/ops.env: shared by every app's updater (root-owned, 0640, your group).
# systemd reads it as an EnvironmentFile; nothing here is executed.

# Read CI runs with the existing `gh auth login`, or set a fine-grained token with
# Actions:read and Contents:read on each deployed repo:
# GH_TOKEN=

# Optional endpoint that accepts a text/plain POST when a deploy fails or rolls back
# (for example an ntfy.sh topic URL):
# ALERT_URL=
