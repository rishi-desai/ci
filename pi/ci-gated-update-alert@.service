# Template, filled in by pi/install.sh. The instance is the app whose deploy failed.
[Unit]
Description=Report a failed CI-gated deploy of %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
EnvironmentFile=-/etc/ci-gated-update/ops.env
ExecStart=@CI_DIR@/pi/alert.sh %i
TimeoutStartSec=1min
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
